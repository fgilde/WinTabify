<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Description>Gather File Explorer windows into a single tab strip.</Description>
    <RepositoryUrl>https://github.com/fgilde/WinTabify</RepositoryUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nextended.UI" Version="10.1.53" />
    <Resource Include="Assets/app.ico" />
    <InternalsVisibleTo Include="WinTabify.Tests" />
  </ItemGroup>
</Project>
